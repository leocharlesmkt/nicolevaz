---
import { Image, Picture, getImage } from "astro:assets";
import Icon from "../components/Icon.astro";
import hero from "../assets/hero-nicole-velas.png";
import portrait from "../assets/nicole-ambiente.webp";
import work from "../assets/nicole-atendimento.webp";
import closeup from "../assets/nicole-retrato.webp";
import sport from "../assets/massagem-desportiva.webp";
import room from "../assets/nicole-espaco.webp";
import atmosphere from "../assets/nicole-sala.webp";
import personal from "../assets/nicole-vaz.webp";
import "../styles/global.css";
const contact = (
  message = "Olá, Nicole! Vi seu site e gostaria de agendar uma massagem na Barra da Tijuca.",
) => `https://wa.me/5521966575078?text=${encodeURIComponent(message)}`;
const maps =
  "https://www.google.com/maps/search/?api=1&query=" +
  encodeURIComponent(
    "Avenida das Américas, 7890, Barra da Tijuca, Rio de Janeiro",
  );
const canonical = Astro.site ? new URL("/", Astro.site).href : undefined;
const socialImage = await getImage({ src: hero, width: 1200, format: "webp" });
const title = "Massagem na Barra da Tijuca | Nicole Vaz";
const description =
  "Massagem relaxante, tântrica e desportiva com Nicole Vaz na Barra da Tijuca. Av. das Américas, 7890. Seg–sex, 10h às 22h; sábado, 10h às 20h. Agende.";
const services = [
  {
    name: "Massagem relaxante",
    icon: "leaf",
    benefit: "Desacelerar também é se cuidar",
    text: "Uma pausa no ritmo do dia, com movimentos suaves para relaxar e dedicar atenção ao seu corpo.",
  },
  {
    name: "Massagem tântrica",
    icon: "flower",
    benefit: "Presença, respiração e consciência corporal",
    text: "Uma abordagem de bem-estar voltada à percepção do corpo e ao relaxamento, respeitando seus limites e seu ritmo.",
  },
  {
    name: "Massagem desportiva",
    icon: "body",
    benefit: "Atenção para quem vive em movimento",
    text: "Cuidado direcionado aos músculos e às tensões da rotina de atividade física, conforme suas necessidades.",
  },
];
const gallery = [
  {
    src: sport,
    alt: "Nicole durante uma sessão de massagem na perna",
    caption: "Atenção em cada movimento",
  },
  {
    src: room,
    alt: "Nicole em uma sala com maca de massagem",
    caption: "Um tempo para desacelerar",
  },
  {
    src: atmosphere,
    alt: "Nicole ao lado de uma maca em um ambiente de atendimento",
    caption: "Cuidado em cada detalhe",
  },
  {
    src: personal,
    alt: "Nicole Vaz de vestido preto junto a uma escada",
    caption: "Conheça Nicole Vaz",
  },
];
const faqs = [
  [
    "Onde fica o atendimento?",
    "Na Avenida das Américas, 7890, na Barra da Tijuca, Rio de Janeiro. Ao agendar, peça à Nicole as orientações de chegada e os detalhes de acesso.",
  ],
  [
    "Quais são os horários?",
    "De segunda a sexta, das 10h às 22h, e aos sábados, das 10h às 20h. Consulte pelo WhatsApp os horários disponíveis para a sua sessão.",
  ],
  [
    "Qual massagem devo escolher?",
    "Conte à Nicole se você busca relaxar, trabalhar a consciência corporal ou cuidar das tensões ligadas à atividade física. Essa conversa ajuda a escolher o cuidado adequado ao seu momento.",
  ],
  [
    "Qual é o valor e a duração da sessão?",
    "O valor e a duração dependem da modalidade. Converse com Nicole pelo WhatsApp para receber as informações antes de confirmar seu agendamento.",
  ],
  [
    "Preciso agendar antes de ir?",
    "Sim. Entre em contato pelo WhatsApp para combinar a modalidade, o dia e o horário do atendimento.",
  ],
  [
    "O que preciso informar antes da massagem?",
    "Conte sobre desconfortos, condições de saúde, gestação, uso de medicamentos ou cirurgias recentes para que a adequação da sessão seja avaliada.",
  ],
];
const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Nicole Vaz — Massagem Relaxante e Tântrica",
  description,
  telephone: "+55-21-96657-5078",
  ...(canonical
    ? { url: canonical, image: new URL(socialImage.src, canonical).href }
    : {}),
  address: {
    "@type": "PostalAddress",
    streetAddress: "Avenida das Américas, 7890, Barra da Tijuca",
    addressLocality: "Rio de Janeiro",
    addressRegion: "RJ",
    addressCountry: "BR",
  },
  areaServed: "Barra da Tijuca, Rio de Janeiro",
  hasMap: maps,
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "10:00",
      closes: "22:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "Saturday",
      opens: "10:00",
      closes: "20:00",
    },
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Massagens e bem-estar",
    itemListElement: services.map(({ name }) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name },
    })),
  },
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#210c15" />
    <meta
      name="robots"
      content={canonical ? "index, follow" : "noindex, nofollow"}
    />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Nicole Vaz" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && (
      <>
        <meta property="og:url" content={canonical} />
        <meta
          property="og:image"
          content={new URL(socialImage.src, canonical).href}
        />
      </>
    )}
    <meta
      property="og:image:alt"
      content="Nicole Vaz, profissional de massagem no Rio de Janeiro"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {canonical && (
      <meta
        name="twitter:image"
        content={new URL(socialImage.src, canonical).href}
      />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <a class="skip" href="#conteudo">
      Ir para o conteúdo
    </a>
    <div class="topbar">
      <div class="container">
        <span>
          <Icon name="pin" size={13} /> Barra da Tijuca · Rio de Janeiro
        </span>
        <a href="#localizacao">Seg–sex: 10h–22h · Sáb: 10h–20h</a>
      </div>
    </div>
    <header class="header">
      <div class="container nav-wrap">
        <a href="#inicio" class="brand">
          <span class="brand-mark" aria-hidden="true">
            <img src="/logo-simbolo.svg" alt="" width="80" height="80" />
          </span>
          <span>
            Nicole Vaz<small>MASSAGEM RELAXANTE & TÂNTRICA</small>
          </span>
        </a>
        <nav aria-label="Navegação principal">
          <a href="#cuidados">Massagens</a>
          <a href="#nicole">Nicole</a>
          <a href="#espaco">Galeria</a>
          <a href="#localizacao">Local e horários</a>
        </nav>
        <div class="header-actions">
          <a
            class="social-icon"
            href={contact()}
            aria-label="Conversar com Nicole pelo WhatsApp"
          >
            <Icon name="whatsapp" size={21} />
          </a>
          <a class="button button-small" href={contact()}>
            Agendar meu momento <Icon name="arrow" size={18} />
          </a>
        </div>
      </div>
    </header>
    <main id="conteudo">
      <section class="hero" id="inicio">
        <div class="hero-image">
          <Picture
            src={hero}
            formats={["webp"]}
            widths={[640, 960, 1280, 1672]}
            sizes="100vw"
            alt="Nicole Vaz ao lado de uma maca em um ambiente de luz quente"
            width={1672}
            height={941}
            loading="eager"
            fetchpriority="high"
            quality={82}
          />
        </div>
        <div class="hero-wash" aria-hidden="true"></div>
        <div class="container hero-inner">
          <div class="hero-copy">
            <p class="eyebrow">
              <span class="status-dot"></span> MASSAGEM NA BARRA DA TIJUCA
            </p>
            <h1>
              Menos pressa.
              <br />
              Mais presença.
              <br />
              <em>Um tempo seu.</em>
            </h1>
            <p class="lead">
              Massagem relaxante e tântrica com Nicole Vaz. Um ambiente
              intimista para desacelerar e se reconectar com seu corpo, na Barra
              da Tijuca.
            </p>
            <a class="button" href={contact()}>
              <Icon name="whatsapp" size={19} /> Agendar minha massagem{" "}
              <Icon name="arrow" size={20} />
            </a>
            <p class="micro">Converse diretamente com Nicole pelo WhatsApp.</p>
            <a class="hero-location" href="#localizacao">
              <Icon name="pin" size={20} />
              <span>
                Seu momento tem endereço
                <strong>Av. das Américas, 7890 · Barra</strong>
              </span>
              <Icon name="arrow" size={18} />
            </a>
          </div>
        </div>
        <div class="hero-photo-caption">
          <span class="caption-line"></span>
          <span>
            Nicole Vaz<small>MASSAGEM RELAXANTE & TÂNTRICA.</small>
          </span>
        </div>
        <a class="scroll-hint" href="#cuidados">
          ENCONTRE SUA PAUSA <span aria-hidden="true">↓</span>
        </a>
      </section>
      <div class="ribbon">
        <div class="container">
          <div>
            <Icon name="hands" size={27} />
            <span>
              Cuidado individual<small>Escuta e respeito ao seu ritmo</small>
            </span>
          </div>
          <div>
            <Icon name="flower" size={27} />
            <span>
              Corpo e presença<small>Um convite para desacelerar</small>
            </span>
          </div>
          <div>
            <Icon name="pin" size={27} />
            <span>
              Na Barra da Tijuca<small>Avenida das Américas, 7890</small>
            </span>
          </div>
        </div>
      </div>
      <section class="intro section container">
        <div class="intro-ornament" aria-hidden="true">
          <span></span>
          <Icon name="flower" size={36} />
          <span></span>
        </div>
        <p class="eyebrow">O SEU BEM-ESTAR TAMBÉM MERECE ESPAÇO</p>
        <h2>
          Saia do automático.
          <br />
          <em>Volte a sentir seu ritmo.</em>
        </h2>
        <p>
          Entre compromissos e dias intensos, o corpo pede atenção. A massagem é
          um convite para fazer uma pausa, respirar com calma e cuidar de você
          com presença.
        </p>
      </section>
      <section class="care section" id="cuidados">
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="eyebrow">TRÊS FORMAS DE CUIDAR DE VOCÊ</p>
              <h2>
                O cuidado certo
                <br />
                <em>para o seu momento.</em>
              </h2>
            </div>
            <p>
              Relaxamento, consciência corporal ou atenção à rotina de
              exercícios. Converse com Nicole para escolher sua sessão.
            </p>
          </div>
          <div class="services">
            {services.map(({ name, icon, benefit, text }, index) => (
              <article class="service">
                <div class="service-top">
                  <span class="service-icon">
                    <Icon name={icon} size={33} />
                  </span>
                  <span class="service-number">0{index + 1}</span>
                </div>
                <h3>{name}</h3>
                <p class="benefit">{benefit}</p>
                <p>{text}</p>
                <a
                  href={contact(
                    `Olá, Nicole! Gostaria de saber mais sobre ${name.toLowerCase()} e consultar os horários.`,
                  )}
                  aria-label={`Conversar sobre este cuidado: ${name}`}
                >
                  Conversar sobre este cuidado <span aria-hidden="true">↗</span>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
      <section class="about section container" id="nicole">
        <div class="about-photo">
          <div class="about-main">
            <Image
              src={portrait}
              alt="Nicole Vaz em um ambiente com iluminação acolhedora"
              width={340}
              height={510}
              loading="lazy"
            />
          </div>
          <div class="about-inset">
            <Image
              src={work}
              alt="Nicole durante um atendimento de massagem nas mãos"
              width={267}
              height={510}
              loading="lazy"
            />
          </div>
          <div class="about-seal">
            <Icon name="hands" size={30} />
            <span>
              PRESENÇA
              <br />E CUIDADO
            </span>
          </div>
          <span class="photo-caption">UM ENCONTRO COM O SEU BEM-ESTAR</span>
        </div>
        <div>
          <p class="eyebrow">PRAZER, NICOLE</p>
          <h2>
            Um cuidado que começa
            <br />
            <em>com atenção a você.</em>
          </h2>
          <p>
            Sou Nicole Vaz e trabalho com massagem relaxante, tântrica e
            desportiva na Barra da Tijuca, no Rio de Janeiro.
          </p>
          <p>
            Cada pessoa chega com uma rotina e uma necessidade. Por isso, antes
            da sessão, conversamos sobre o que você procura e como está se
            sentindo. Esse é o primeiro passo para um cuidado que respeita seu
            corpo e seus limites.
          </p>
          <div class="signature">Nicole Vaz</div>
          <a class="text-link" href={contact()}>
            Vamos conversar? <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
      <section class="space section" id="espaco">
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="eyebrow">CONHEÇA UM POUCO MAIS</p>
              <h2>
                Atenção aos detalhes.
                <br />
                <em>Espaço para você.</em>
              </h2>
            </div>
            <p>
              Conheça Nicole e veja os registros de atendimento e dos ambientes
              apresentados na galeria.
            </p>
          </div>
          <div class="gallery">
            {gallery.map(({ src, alt, caption }, index) => (
              <figure class:list={{ "gallery-main": index === 0 }}>
                <Image
                  src={src}
                  alt={alt}
                  width={src.width}
                  height={src.height}
                  loading="lazy"
                />
                <figcaption>{caption}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
      <section class="ritual section container">
        <div class="ritual-photo">
          <Image
            src={closeup}
            alt="Retrato de Nicole Vaz"
            width={373}
            height={510}
            loading="lazy"
          />
          <span class="ritual-caption">CUIDADO QUE RESPEITA QUEM VOCÊ É.</span>
        </div>
        <div>
          <p class="eyebrow">CONSCIÊNCIA CORPORAL & BEM-ESTAR</p>
          <h2>
            Respire com calma.
            <br />
            <em>Este momento é seu.</em>
          </h2>
          <p>
            Não é preciso chegar com todas as respostas. Conte como você está,
            tire suas dúvidas e conheça as possibilidades de cuidado antes de
            agendar.
          </p>
          <p>
            Na abordagem tântrica de bem-estar, a atenção está na presença, na
            respiração e na percepção corporal, com respeito aos seus limites.
          </p>
          <a
            class="button"
            href={contact(
              "Olá, Nicole! Gostaria de entender como funciona a massagem tântrica de bem-estar.",
            )}
          >
            Conversar sobre a sessão <Icon name="arrow" size={18} />
          </a>
        </div>
      </section>
      <section class="booking section" id="localizacao">
        <div class="container">
          <p class="eyebrow">SEU MOMENTO NA BARRA DA TIJUCA</p>
          <div class="section-heading">
            <h2>
              Um endereço para
              <br />
              <em>deixar a pressa lá fora.</em>
            </h2>
            <p>
              Atendimento com agendamento, de segunda a sábado. Escolha seu dia
              e consulte a disponibilidade com Nicole.
            </p>
          </div>
          <div class="locations">
            <article>
              <div class="location-top">
                <Icon name="pin" size={25} />
                <span class="eyebrow">ONDE ENCONTRAR</span>
              </div>
              <h3>Barra da Tijuca</h3>
              <address>
                Avenida das Américas, 7890
                <br />
                Barra da Tijuca · Rio de Janeiro, RJ
              </address>
              <a
                class="text-link"
                href={maps}
                target="_blank"
                rel="noopener noreferrer"
              >
                Abrir no Google Maps <span aria-hidden="true">↗</span>
              </a>
            </article>
            <article>
              <div class="location-top">
                <Icon name="leaf" size={25} />
                <span class="eyebrow">QUANDO AGENDAR</span>
              </div>
              <h3>No seu tempo.</h3>
              <dl class="hours">
                <div>
                  <dt>Segunda a sexta</dt>
                  <dd>10h às 22h</dd>
                </div>
                <div>
                  <dt>Sábado</dt>
                  <dd>10h às 20h</dd>
                </div>
              </dl>
              <a class="text-link" href={contact()}>
                Consultar disponibilidade <span aria-hidden="true">↗</span>
              </a>
            </article>
          </div>
          <ol class="steps">
            <li>
              <span>01</span>
              <div>
                <h3>Chame no WhatsApp</h3>
                <p>Conte qual cuidado você procura.</p>
              </div>
            </li>
            <li>
              <span>02</span>
              <div>
                <h3>Combine sua sessão</h3>
                <p>Confirme modalidade, valor e horário.</p>
              </div>
            </li>
            <li>
              <span>03</span>
              <div>
                <h3>Reserve esse tempo</h3>
                <p>Venha aproveitar seu momento.</p>
              </div>
            </li>
          </ol>
        </div>
      </section>
      <section class="faq section container" id="duvidas">
        <div>
          <p class="eyebrow">ANTES DE AGENDAR</p>
          <h2>
            Sua pausa,
            <br />
            <em>sem dúvidas.</em>
          </h2>
          <p>
            Quer saber mais sobre o atendimento? Converse diretamente com
            Nicole.
          </p>
          <a
            class="text-link"
            href={contact("Olá, Nicole! Tenho uma dúvida sobre o atendimento.")}
          >
            Tirar minha dúvida <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="faq-list">
          {faqs.map(([question, answer]) => (
            <details>
              <summary>
                {question}
                <span aria-hidden="true">+</span>
              </summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </section>
      <section class="final-cta">
        <Image
          class="final-cta-image"
          src={sport}
          alt=""
          aria-hidden="true"
          width={sport.width}
          height={sport.height}
          loading="lazy"
        />
        <div class="container">
          <p class="eyebrow">UMA PAUSA PODE MUDAR O RITMO DO SEU DIA</p>
          <h2>
            Permita-se desacelerar.
            <br />
            <em>Cuide do seu momento.</em>
          </h2>
          <a class="button button-light" href={contact()}>
            Agendar pelo WhatsApp <Icon name="whatsapp" size={20} />
          </a>
          <p class="micro">Barra da Tijuca · Segunda a sábado</p>
        </div>
      </section>
    </main>
    <footer class="footer">
      <div class="container footer-main">
        <a class="brand" href="#inicio">
          <span class="brand-mark" aria-hidden="true">
            <img src="/logo-simbolo.svg" alt="" width="80" height="80" />
          </span>
          <span>
            Nicole Vaz<small>MASSAGEM RELAXANTE & TÂNTRICA</small>
          </span>
        </a>
        <div class="footer-contact">
          <span class="eyebrow">VAMOS CONVERSAR</span>
          <a href="tel:+5521966575078">(21) 96657-5078</a>
          <a class="contact-link" href={contact()}>
            <Icon name="whatsapp" size={21} /> Falar com Nicole{" "}
            <Icon name="arrow" size={17} />
          </a>
        </div>
        <p>
          Seu corpo, seu ritmo.
          <br />
          Seu momento de cuidado.
          <span>Av. das Américas, 7890 · Barra da Tijuca</span>
        </p>
      </div>
      <div class="container footer-bottom">
        <p>© {new Date().getFullYear()} Nicole Vaz.</p>
        <a href="#inicio">Voltar ao início ↑</a>
      </div>
    </footer>
    <a class="floating-wa" href={contact()} aria-label="Agendar pelo WhatsApp">
      <span class="wa-tooltip">Agende seu momento</span>
      <Icon name="whatsapp" size={32} />
    </a>
    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>
